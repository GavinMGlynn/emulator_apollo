; ==== Apollo option ROM header ====
; 0000 magic0     0x335E91B6   ; constant 0x335E91B6, matched by the boot PROM
; 0004 magic1     0x0000A0B6   ; constant 0x0000A0B6
; 0008 rom_id     b'R   '      ; 4-char ROM class ('R   ' ring, 'E   ' ethernet)
; 000C length     0x00000EAC   ; bytes of image covered by the checksum
; 0010 checksum   0xBBBC213D   ; fudge longword: sum32 of image == 0
; 0014 revision   b' 3.6'      ; ASCII revision, e.g. ' 3.6'
; 0018 hdr_ver    0x01         ; header format version
; 0019 board_ver  0x01         ; board/hardware variant
; 001A field_1a   0x0002       ; unknown, 0x0002 on ring ROMs
; 001C field_1c   0x00000700   ; unknown, 0x00000700 ring / 0x00000703 3C505
; 0020 field_20   0x00000000   ; unknown, zero
; 0024 name_off   0x00000068   ; offset of the ASCII controller name
; 0028 field_28   0x00000000   ; unknown, zero
; 002C field_2c   0x00000000   ; unknown, zero
; 0030 pad        b'\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00' ; zero padding
; 0048 n_entries  0x0005       ; number of entry-point table records
; sum32 over [0, length) = 0x00000000  (VALID)
; ---- entry-point table @ 0x004A: 5 records of 6 bytes ----
; id=0x01  offset=0x00000090  init
; id=0x02  offset=0x00000150  entry_02
; id=0x03  offset=0x00000166  entry_03
; id=0x04  offset=0x00000232  entry_04
; id=0x05  offset=0x000002D4  entry_05
;
; base = 0x000000

000000  dc.b     $33,$5E,$91,$B6,$00,$00,$A0,$B6
000008  dc.b     "R   ",0
00000D  dc.b     $00,$0E,$AC,$BB,$BC,$21,$3D,$20,$33,$2E,$36,$01,$01,$00,$02,$00
