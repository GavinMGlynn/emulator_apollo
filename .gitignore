# Build trees (CMake presets write here)
build/

# User-supplied images — NEVER commit these. This repository is public and
# Apollo boot/ring firmware and Domain/OS media are not ours to redistribute.
#
# Anchored with a leading slash, deliberately. Unanchored, `roms/` and `media/`
# match a directory of that name at *any* depth: `src/core/media` was silently
# untracked once by exactly this rule, and had to be renamed to `src/core/image`
# to get it back. Anchoring keeps the protection where it is needed — the
# top-level image directories — without swallowing source directories that
# happen to share a name.
/roms/
/media/

# Vendored hardware manuals stay local: reference only, vendor copyright.
docs/references/**/*.pdf
docs/references/**/*.txt.gz

# Oracle scratch
tools/mame-oracle/out/
# MAME writes snapshots beside its working directory when a run does not
# redirect them. Our drivers do redirect, so this catches runs made by hand.
/snap/
__pycache__/
*.awd
*.afd
*.ct
*.ct.gz

# Per-user Claude Code settings (project settings.json is tracked)
.claude/settings.local.json

# Editor / tooling
compile_commands.json
.cache/
.vscode/
*.swp

# Python venv for probe/disassembly tooling
tools/.venv/

# Scratch disassembly listings (the tool that makes them is tracked)
tools/ring-rom/*.lst
